                k067{"A067 Condition<br/>Request Next Level<br/>Approval: Approved<br/>AND title<br/>ne Manager"}:::condition
                subgraph s067y["A067 Condition Request Next Level Approval – If yes"]
                    p091["A069 to A100 Divisional Manager<br/>level, A091 Scope APPROVAL<br/>REQUEST (Manager)"]:::approval
                    k101{"A101 Condition<br/>Value (R) gt R5m<br/>(Approved AND<br/>ge 5000000) OR<br/>GM Approval Req."}:::condition
                    subgraph s101y["A101 Condition Value (R) gt R5m – If yes"]
